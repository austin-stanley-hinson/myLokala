# Supabase — copy to .env.local and fill from your project dashboard
NEXT_PUBLIC_SUPABASE_URL=
# Dashboard "anon / public" key. Either name works; newer projects copy the
# publishable name instead.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Supabase — SERVICE ROLE key. Server-side ONLY: bypasses Row Level Security.
# NEVER expose to the browser and NEVER prefix with NEXT_PUBLIC_. Used only by
# trusted server code (e.g. resolving a scanned QR public_code to its merchant's
# Stripe connected account in the payment-intent route).
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_MAPS_API_KEY=

# Stripe — server-side secret key (never expose to the client / do not use NEXT_PUBLIC)
STRIPE_SECRET_KEY=
# Stripe — browser publishable key (safe to expose). Used by Stripe.js for gift
# certificate checkout. Must be from the same Stripe account + mode (test/live)
# as STRIPE_SECRET_KEY.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Stripe — webhook signing secret (whsec_...) for /api/stripe/webhook. Server-side
# ONLY. Without it the webhook rejects every delivery, so payments would never
# reach a terminal status and gift credit would never be issued.
STRIPE_WEBHOOK_SECRET=
# Stripe — Connect webhook signing secret (whsec_...) for
# /api/stripe/connect/webhook. Server-side ONLY. Separate from the PaymentIntent
# ledger webhook so Connect account.updated events can be routed independently.
STRIPE_CONNECT_WEBHOOK_SECRET=

# Resend — server-side API key for sending the gift-claim email directly via
# Resend's HTTP API (not Supabase Auth SMTP). Sending domain: mail.mylokala.com.
RESEND_API_KEY=
# Optional. Base URL this server uses to build links it sends itself (e.g. the
# gift-claim email link) -- distinct from src/lib/seo.ts's SITE_URL, which is
# deliberately hardcoded to production for canonical/OG tags. Falls back to
# Vercel's own VERCEL_URL, then http://localhost:3000, so this is only needed
# to override that default (e.g. a custom preview domain).
# NEXT_PUBLIC_SITE_URL=
